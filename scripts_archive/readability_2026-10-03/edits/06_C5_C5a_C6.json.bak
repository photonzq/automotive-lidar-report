{
 "block": "06_C5_C5a_C6",
 "edits": [
  {
   "id": "06_C5_C5a_C6-001",
   "finding": "report #14",
   "old": "ranging pixel), so it is a first test for a Sony part (details in §C5a).",
   "new": "ranging pixel). Sony's two automotive parts bin to 192 and 520 lines, so a product with exactly one of these counts is a first suspect for a Sony part (details in §C5a).",
   "why": "Says why line count is a test: Sony's parts bin to 192 and 520 lines."
  },
  {
   "id": "06_C5_C5a_C6-002",
   "finding": "report #23",
   "old": "(90 nm SPAD / 40 nm logic in the ISSCC 2021 design), PDE 24% at 905 nm. Binned: about **192** lines [P].\n- **Sony IMX479:** 105×1,568 SPADs, 10.08 µm, **520 dToF pixels** at 0.05° vertical, PDE 37% at 940 nm, 3 GHz equivalent-time sampling, about 98% on-chip data reduction, 25 Mpts/s [P].",
   "new": "(a 90 nm SPAD process [I] and, per trade press only, 40 nm logic [T]; §C5a), PDE (photon detection efficiency, the share of arriving photons that are counted) 24% at 905 nm [P]. Binned: about **192** lines [P].\n- **Sony IMX479:** 105×1,568 SPADs, 10.08 µm, **520 dToF pixels** at 0.05° vertical, PDE 37% at 940 nm, about 98% on-chip data reduction and 25 Mpts/s [P]; 3 GHz equivalent-time sampling [I, §C5a].",
   "why": "Tags the 90 nm [I] and 40 nm [T] nodes separately and expands PDE at first use in §C5. Tags 3 GHz equivalent-time sampling [I] as in §C5a, since the papers do not name the part."
  },
  {
   "id": "06_C5_C5a_C6-003",
   "finding": "report #36",
   "old": "| Product | Verified | Inferred / unknown |",
   "new": "The table lists, for each Chinese lidar or receiver chip, what teardowns or vendor documents establish and what is only inferred; Hesai's two SiPM-based units, AT128 and ATX, are included for contrast.\n\n| Product | Documented (teardown or vendor) | Inferred / unknown |",
   "why": "Adds a table lead-in, says why the SiPM units are there, and renames the 'Verified' column."
  },
